# Copy to .env and fill in. Never commit .env.
# Elasticsearch superuser: used ONLY by es/setup_security.py and es/setup_indices.py
ELASTIC_PASSWORD=change-me-elastic
KIBANA_PASSWORD=change-me-kibana
ES_URL=http://localhost:9200
# Written by es/setup_security.py: the API key the app uses (role rag_app)
ES_API_KEY=

# GeoServer admin: used ONLY by geoserver/setup_geoserver.py
GEOSERVER_ADMIN_PASSWORD=change-me-geoserver
GEOSERVER_URL=http://localhost:8080/geoserver
# Read-only user the app uses (role ROLE_RAG_GEO)
RAG_GEO_USER=rag_geo
RAG_GEO_PASSWORD=change-me-rag-geo

# Local LLM server (llama.cpp llama-server, OpenAI-compatible)
LLM_URL=http://localhost:8081
LLM_MODEL=qwen2.5-3b-instruct-q4_k_m

# Local models (Hugging Face ids or local folders)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_MODEL_B=intfloat/e5-base-v2
RERANK_MODEL=BAAI/bge-reranker-base
