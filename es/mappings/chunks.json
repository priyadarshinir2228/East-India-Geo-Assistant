      "embedding": {
        "type": "dense_vector", "dims": __DIMS__, "similarity": "cosine", "index": true,
        "index_options": {"type": "int8_hnsw", "m": 16, "ef_construction": 100}
      },
      "embedding_f32": {
        "type": "dense_vector", "dims": __DIMS__, "similarity": "cosine", "index": true,
        "index_options": {"type": "hnsw", "m": 16, "ef_construction": 100}
      }
    }
  }
